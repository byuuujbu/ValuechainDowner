{
  "name": "ovsa",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "dev:api": "cd apps/api && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
    "test:api": "cd apps/api && python -m pytest",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
